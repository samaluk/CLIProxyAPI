# Reuse the reviewed core and native plugins when only the catalog/proxy changes.
FROM --platform=$BUILDPLATFORM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS build
ARG TARGETOS
ARG TARGETARCH
ARG GATEWAY_COMMIT
WORKDIR /build/gateway
COPY gateway/ ./
RUN test "${#GATEWAY_COMMIT}" -eq 40 && \
    case "$GATEWAY_COMMIT" in *[!0-9a-f]*) exit 1;; esac && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOAMD64=v1 go build -trimpath -buildvcs=false -o /out/cpa-gateway . && \
    printf '{"repository":"samaluk/CLIProxyAPI","commit":"%s","file":"cpa-gateway","sha256":"%s"}\n' \
      "$GATEWAY_COMMIT" "$(sha256sum /out/cpa-gateway | cut -d ' ' -f 1)" > /out/gateway-provenance.json

FROM ghcr.io/samaluk/cpa-gateway:20261023-upstream-defaults-1@sha256:c30dd8a9f7d414eedfd1b87cf9151fc538d11c739998d428a0bdacc810c4a9a1
ARG GATEWAY_COMMIT
LABEL io.cpa.gateway.revision=$GATEWAY_COMMIT
COPY --from=build /out/cpa-gateway /out/gateway-provenance.json /opt/cpa/
